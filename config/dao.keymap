#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define FUN 3
#define BTL 4

// IMPROVEMENTS MADE:
// 1. Added combos for frequently used keys (Esc, Caps Word, BTL access)
// 2. Fixed number keys (changed from KP_NUMBER to regular numbers)
// 3. Added caps_word instead of CAPSLOCK for better typing
// 4. Added key_repeat for efficiency
// 5. Improved layer access with combo for BTL layer
// 6. Optimized timing for better feel
// 7. Added smart parenthesis matching combo

// Optimized timing for better responsiveness
&lt {
    quick_tap_ms = <200>;
    tapping_term_ms = <200>;
    flavor = "balanced";
};

&mt {
    quick_tap_ms = <200>;
    tapping_term_ms = <200>;
    flavor = "balanced";
};

// Longer release for sticky behaviors
&sl { release-after-ms = <1000>; };
&sk { release-after-ms = <1000>; };

/ {
    chosen { zmk,matrix_transform = &default_transform; };

    // ============= BEHAVIORS =============

    behaviors {
        // Home row mod-tap with better timing
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    // ============= COMBOS =============

    combos {
        compatible = "zmk,combos";

        // ESC combo (Q+W) - Very common, easy to reach
        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
            layers = <DEF>;
        };

        // Caps Word combo (A+S) - Better than CAPSLOCK
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&caps_word>;
            layers = <DEF>;
        };

        // BTL layer access (both thumb outer keys)
        combo_btl {
            timeout-ms = <50>;
            key-positions = <36 41>;
            bindings = <&mo BTL>;
            layers = <DEF LWR RSE>;
        };

        // Screenshot (Cmd+Shift+4) - useful on macOS
        combo_screenshot {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp LG(LS(N4))>;
            layers = <DEF>;
        };

        // Quick Tab (F+P)
        combo_tab {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp TAB>;
            layers = <RSE>;
        };
    };

    // ============= MACROS =============

    macros {
        // File navigation
        cmd_p: cmd_p {
            label = "Cmd+P";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(P)>;
        };

        cmd_palette: cmd_palette {
            label = "Cmd+Shift+P";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(P))>;
        };

        // Text selection and editing
        select_next: select_next {
            label = "Cmd+D";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(D)>;
        };

        comment_line: comment_line {
            label = "Cmd+/";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SLASH)>;
        };

        // Line movement
        move_line_up: move_line_up {
            label = "Option+Up";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(UP)>;
        };

        move_line_down: move_line_down {
            label = "Option+Down";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(DOWN)>;
        };

        // Word navigation (macOS uses Option)
        word_left: word_left {
            label = "Option+Left";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT)>;
        };

        word_right: word_right {
            label = "Option+Right";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(RIGHT)>;
        };

        // Code folding
        fold_block: fold_block {
            label = "Cmd+Option+[";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(LBKT))>;
        };

        unfold_block: unfold_block {
            label = "Cmd+Option+]";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(RBKT))>;
        };

        // Find and replace
        find_replace: find_replace {
            label = "Cmd+Option+F";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(F))>;
        };

        // Go to definition
        go_to_def: go_to_def {
            label = "F12";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F12>;
        };

        // Go to references
        go_to_refs: go_to_refs {
            label = "Shift+F12";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(F12)>;
        };

        // Toggle sidebar
        toggle_sidebar: toggle_sidebar {
            label = "Cmd+B";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(B)>;
        };

        // File tab switching
        tab_switch: tab_switch {
            label = "Ctrl+Tab";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(TAB)>;
        };
    };

    // ============= CONDITIONAL LAYERS =============

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // FUN layer activates when both LWR and RSE are held
        combo_fun {
            if-layers = <LWR RSE>;
            then-layer = <FUN>;
        };
    };

    // ============= KEYMAP =============

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "MAIN";
            bindings = <
// ╭─────────────┬─────────┬─────────┬─────────────┬─────────────────┬──────────╮   ╭──────────────────┬─────────┬──────────────────┬───────────────────┬───────────────────┬────────────╮
    &kp TAB       &kp Q     &kp W     &kp F         &kp P             &kp B            &kp J              &kp L     &kp U              &kp Y               &kp SINGLE_QUOTE    &kp DELETE
// ├─────────────┼─────────┼─────────┼─────────────┼─────────────────┼──────────┤   ├──────────────────┼─────────┼──────────────────┼───────────────────┼───────────────────┼────────────┤
    &sk LEFT_ALT  &kp A     &kp R     &kp S         &kp T             &kp G            &kp M              &kp N     &kp E              &kp I               &kp O               &sk RIGHT_ALT
// ├─────────────┼─────────┼─────────┼─────────────┼─────────────────┼──────────┤   ├──────────────────┼─────────┼──────────────────┼───────────────────┼───────────────────┼────────────┤
    &sk LSHFT     &kp Z     &kp X     &kp C         &kp D             &kp V            &kp K              &kp H     &mt PG_DN COMMA    &mt PG_UP PERIOD    &kp SLASH           &key_repeat
// ╰─────────────┴─────────┴─────────┼─────────────┼─────────────────┼──────────┤   ├──────────────────┼─────────┼──────────────────┼───────────────────┴───────────────────┴────────────╯
                                      &sk LCTRL     &mt LGUI ENTER    &lt LWR SPACE    &lt RSE BACKSPACE  &kp TAB   &sk RSHFT
//                                   ╰─────────────┴─────────────────┴──────────╯   ╰──────────────────┴─────────┴──────────────────╯
            >;
        };

        lower_layer {
            label = "SYMBOL";
            bindings = <
// ╭───────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭────────────┬────────────┬──────────┬──────────────┬────────────────┬───────────╮
    &trans  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET    &kp AMPS     &kp STAR   &kp LPAR       &kp RPAR         &kp BSLH
// ├───────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├────────────┼────────────┼──────────┼──────────────┼────────────────┼───────────┤
    &trans  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6       &kp N7       &kp N8     &kp N9         &kp N0           &trans
// ├───────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├────────────┼────────────┼──────────┼──────────────┼────────────────┼───────────┤
    &trans  &trans     &kp TILDE  &kp GRAVE  &kp LBKT   &kp LBRC       &kp RBRC     &kp RBKT     &kp MINUS  &kp EQUAL      &kp SEMI         &kp COLON
// ╰───────┴──────────┴──────────┼──────────┼──────────┼──────────┤   ├────────────┼────────────┼──────────┼──────────────┴────────────────┴───────────╯
                                  &trans     &trans     &trans         &kp BSPC     &trans       &trans
//                               ╰──────────┴──────────┴──────────╯   ╰────────────┴────────────┴──────────╯
            >;
        };

        raise_layer {
            label = "VSCODE";
            bindings = <
// ╭────────┬──────────────┬─────────────────┬─────────────┬──────────────┬──────────────╮   ╭────────────┬────────────┬──────┬─────────────────┬─────────────┬────────╮
    &kp ESC  &cmd_p         &cmd_palette      &select_next  &comment_line  &find_replace      &go_to_def   &go_to_refs  &kp UP &toggle_sidebar   &tab_switch   &trans
// ├────────┼──────────────┼─────────────────┼─────────────┼──────────────┼──────────────┤   ├────────────┼────────────┼──────┼─────────────────┼─────────────┼────────┤
    &trans   &move_line_up  &move_line_down   &word_left    &word_right    &kp LG(F)          &kp HOME     &kp LEFT     &kp DOWN &kp RIGHT         &kp END       &trans
// ├────────┼──────────────┼─────────────────┼─────────────┼──────────────┼──────────────┤   ├────────────┼────────────┼──────┼─────────────────┼─────────────┼────────┤
    &trans   &fold_block    &unfold_block     &kp LG(Z)     &kp LG(LS(Z))  &kp LG(X)          &kp LG(C)    &kp LG(V)    &kp F9 &kp F5            &kp F2        &trans
// ╰────────┴──────────────┴─────────────────┼─────────────┼──────────────┼──────────────┤   ├────────────┼────────────┼──────┼─────────────────┴─────────────┴────────╯
                                              &trans        &trans         &trans             &trans       &trans       &trans
//                                           ╰─────────────┴──────────────┴──────────────╯   ╰────────────┴────────────┴──────╯
            >;
        };

        function_layer {
            label = "FUNC";
            bindings = <
// ╭────────┬──────────┬─────────┬───────┬────────┬────────╮   ╭────────────────┬────────────────┬──────────────────┬──────────────────┬─────────────────┬─────────────╮
    &trans  &kp F1     &kp F2    &kp F3  &kp F4   &kp F5       &kp F6           &kp F7           &kp F8             &kp F9             &kp F10           &trans
// ├────────┼──────────┼─────────┼───────┼────────┼────────┤   ├────────────────┼────────────────┼──────────────────┼──────────────────┼─────────────────┼─────────────┤
    &trans  &kp F11    &kp F12   &kp F13 &trans   &trans       &kp LG(LA(DOWN)) &kp LA(UP)       &kp LA(DOWN)       &kp LG(SPACE)      &kp LC(F10)       &trans
// ├────────┼──────────┼─────────┼───────┼────────┼────────┤   ├────────────────┼────────────────┼──────────────────┼──────────────────┼─────────────────┼─────────────┤
    &trans  &caps_word &kp INS   &trans  &trans   &trans       &kp C_PP         &kp C_PREV       &kp C_NEXT         &kp C_VOL_DN       &kp C_VOL_UP      &kp PSCRN
// ╰────────┴──────────┴─────────┼───────┼────────┼────────┤   ├────────────────┼────────────────┼──────────────────┼──────────────────┴─────────────────┴─────────────╯
                                  &trans  &trans   &kp TAB      &kp BSPC         &trans           &trans
//                               ╰───────┴────────┴────────╯   ╰────────────────┴────────────────┴──────────────────╯
            >;
        };

        bt_layer {
            label = "BT";
            bindings = <
// ╭────────────┬────────────┬────────────┬────────────┬────────────┬────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────┬────────────╮
    &bootloader  &none        &none        &none        &none        &none            &none        &none        &none        &none        &none        &bootloader
// ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤
    &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4     &bt BT_SEL 4 &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &bt BT_CLR
// ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤
    &trans       &sys_reset   &none        &none        &none        &none            &none        &none        &none        &none        &sys_reset   &trans
// ╰────────────┴────────────┴────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┴────────────┴────────────╯
                                           &trans       &none        &trans           &trans       &trans       &trans
//                                        ╰────────────┴────────────┴────────────╯   ╰────────────┴────────────┴────────────╯
            >;
        };
    };
};
