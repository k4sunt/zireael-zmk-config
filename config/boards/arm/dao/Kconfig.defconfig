if BOARD_DAO_LEFT

	config ZMK_KEYBOARD_NAME
	default "Dao Left"

    # config ZMK_SPLIT_BLE_ROLE_CENTRAL  # Dongle acts as central
	# 	default y

endif # BOARD_DAO_LEFT

if BOARD_DAO_RIGHT

	config ZMK_KEYBOARD_NAME
	default "Dao Right"

endif # BOARD_DAO_RIGHT

if BOARD_DAO_DONGLE

	config ZMK_KEYBOARD_NAME
	default "Dao Dongle"

    config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

endif # BOARD_DAO_DONGLE

if BOARD_DAO_LEFT || BOARD_DAO_RIGHT || BOARD_DAO_DONGLE

config BOARD
	default "dao"

config ZMK_SPLIT
	default y

config BT_CTLR

	default BT

if !BOARD_DAO_DONGLE

config ZMK_BATTERY_VOLTAGE_DIVIDER
	default y

endif # !BOARD_DAO_DONGLE

if USB

config USB_NRFX
	default y

config USB_DEVICE_STACK
	default y

endif # USB

endif # BOARD_DAO_LEFT || BOARD_DAO_RIGHT || BOARD_DAO_DONGLE
