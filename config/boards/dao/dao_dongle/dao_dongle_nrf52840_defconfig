# SPDX-License-Identifier: MIT

CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SLEEP=y

# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

# Enable writing to flash
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Output BIN for Nordic Open Bootloader DFU
# BIN format works with adafruit-nrfutil for DFU packaging
CONFIG_BUILD_OUTPUT_BIN=y
CONFIG_BUILD_OUTPUT_HEX=n
CONFIG_BUILD_OUTPUT_UF2=n

# Increase transmit power level
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Enable USB device support (Zephyr 4.x correct symbols)
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_INITIALIZE_AT_BOOT=y
CONFIG_USB_COMPOSITE_DEVICE=y

# Enable HID class
CONFIG_USB_DEVICE_HID=y
CONFIG_USB_HID_BOOT_PROTOCOL=y

# ZMK USB glue
CONFIG_ZMK_USB=y

# Enable Nordic USB device driver
CONFIG_USB_DEVICE_DRIVER_NRFX=y
CONFIG_NRF_USBD=y

# Clock source (required for USB)
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y

# USB Device IDs
CONFIG_USB_DEVICE_VID=0x1915
CONFIG_USB_DEVICE_PID=0x521F
CONFIG_USB_DEVICE_MANUFACTURER="Raytac"
CONFIG_USB_DEVICE_PRODUCT="DAO ZMK Dongle"

CONFIG_ZMK_BLE=y

# Dongle is central in dongle-centric split
CONFIG_ZMK_SPLIT_ROLE_CENTRAL=y
