CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SLEEP=y

# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

# Enable writing to flash
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Enable both UF2 and HEX output for dongle
# UF2 ensures artifact is packaged by ZMK workflow
# HEX is needed for Nordic DFU package creation
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_HEX=y
# CONFIG_BUILD_OUTPUT_BIN is not set

# Increase transmit power level
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y

# Dongle specific configurations
CONFIG_ZMK_SPLIT_ROLE_CENTRAL=y

# Dongle has no local keys (keymap on peripherals only)
CONFIG_ZMK_SPLIT_PERIPHERAL_HID_INDICATORS=n
