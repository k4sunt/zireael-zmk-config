/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
	model = "Dao Dongle";
	compatible = "dao,dongle";

	aliases {
        zephyr-udc0 = &usbd;
    };

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;		
		zmk,usb = &usbd;
		zmk,matrix_transform = &default_transform;
	};

	// Matrix transform for the full split keyboard (left + right combined)
	// Dongle has no physical keys but needs to know the keymap size
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <4>;

		// Full 42-key Dao layout (left 6 cols + right 6 cols, 4 rows)
		// | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
		// | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
		// | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
		// |      |      |      | SW20 | SW21 | SW22 |   | SW22 | SW21 | SW20 |      |      |      |
		map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
			                        RC(3,3) RC(3,4) RC(3,5)  RC(3,11) RC(3,10) RC(3,9)
		>;
	};

	leds {
		compatible = "gpio-leds";
		blue_led: led_0 {
			gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
		};
	};
};

&adc {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&usbd {
	status = "okay";
};

&radio {
    status = "okay";
};

blue_led: led_0 {
    gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
};

&flash0 {
	/*
	 * For more information, see:
	 * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
	 */
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * Nordic Open Bootloader partition layout
		 * Open Bootloader occupies 0xE0000-0x100000 (128KB)
		 * Reference: https://infocenter.nordicsemi.com/topic/sdk_nrf5_v17.0.2/lib_bootloader.html
		 */

		boot_partition: partition@0 {
			label = "mbr";
			reg = <0x00000000 0x00001000>;
		};
		sd_partition: partition@1000 {
			label = "softdevice";
			reg = <0x00001000 0x00026000>;
		};
		code_partition: partition@27000 {
			label = "code_partition";
			reg = <0x00027000 0x000b1000>;
		};

		/*
		 * Storage partition will be used by FCB/LittleFS/NVS
		 * if enabled.
		 */
		storage_partition: partition@d8000 {
			label = "storage";
			reg = <0x000d8000 0x00008000>;
		};

		/* Nordic Open Bootloader - 128KB at end of flash */
		bootloader_partition: partition@e0000 {
			label = "bootloader";
			reg = <0x000e0000 0x00020000>;
		};
	};
};
